# DEVELOPMENT / LEGACY CONFIGURATION (ordinary preferences use /settings)

# First-run legacy fallback only; a settings.json file takes precedence.
# Existing model-preference.json is migrated before this fallback.
# OLLAMA_MODEL=<installed-model-name>
# Optional live smoke only; deterministic bun test never requires this.
# TEST_MODEL=qwen3.5:9b
# These ordinary preferences are used ONLY when settings.json is absent.
# The first successful Settings/model save persists all supported values.
# No .env is needed for a clean installation.
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_KEEP_ALIVE=0
# Total model window and independent maximum generation reservation, per request.
MODEL_CONTEXT_TOKENS=16384
MODEL_MAX_OUTPUT_TOKENS=4096

# Optional semantic retrieval of older turns in the selected session only.
# Use an explicitly installed embedding model, independently of OLLAMA_MODEL.
# Unset/blank or unavailable embeddings keep Phase 16 recent-context behavior.
# No model is downloaded automatically.
# HISTORY_EMBEDDING_MODEL=<installed-embedding-model>

# Operational override, excluded from persistent Settings; unset uses built-in guidance.
# SYSTEM_PROMPT=Use workspace-relative paths.
